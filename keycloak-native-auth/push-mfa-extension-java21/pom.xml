<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.phasetwo.keycloak</groupId>
    <artifactId>keycloak-native-auth-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>keycloak-push-mfa-extension-java21</artifactId>
  <name>Keycloak Native Auth :: ba-itsys push MFA, rebuilt for Java 21</name>
  <description>
    The published de.arbeitsagentur.opdt:keycloak-push-mfa-extension jars are compiled for Java 25
    (class file 69) while the quay.io/keycloak/keycloak:26.8.1 image runs Java 21. This module
    unpacks the published sources jar of the same version and recompiles it with release 21 — no
    third-party source is checked in, the result is byte-for-byte the upstream code (spec/14 D9).
  </description>

  <properties>
    <push-mfa.sources>${project.build.directory}/push-mfa-sources</push-mfa.sources>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-services</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.17</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${push-mfa.sources}</sourceDirectory>
    <resources>
      <resource>
        <directory>${push-mfa.sources}</directory>
        <excludes>
          <exclude>**/*.java</exclude>
          <exclude>META-INF/MANIFEST.MF</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-push-mfa-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>de.arbeitsagentur.opdt</groupId>
                  <artifactId>keycloak-push-mfa-extension</artifactId>
                  <version>${push-mfa.version}</version>
                  <classifier>sources</classifier>
                  <outputDirectory>${push-mfa.sources}</outputDirectory>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>false</overWriteReleases>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          The one source-level change: Quarkus refuses @RunOnVirtualThread endpoints when the
          application it builds was compiled below Java 19, and it measures that on Keycloak's own
          classes (26.8.1 is compiled for Java 17), whatever JRE runs. The two SSE streams of
          PushMfaResource therefore run on worker threads here (they block for the challenge TTL;
          the browser wait page also polls through its refresh button).
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>drop-run-on-virtual-thread</id>
            <phase>process-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <replace file="${push-mfa.sources}/de/arbeitsagentur/keycloak/push/resource/PushMfaResource.java"
                         token="@RunOnVirtualThread" value="/* RunOnVirtualThread dropped (idempotent replace): see push-mfa-extension-java21/pom.xml */"/>
                <replace file="${push-mfa.sources}/de/arbeitsagentur/keycloak/push/resource/PushMfaResource.java"
                         token="import io.smallrye.common.annotation.RunOnVirtualThread;" value=""/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>21</release>
          <showWarnings>false</showWarnings>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
