{
  "realm": "demo",
  "displayName": "Native Auth Demo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 30,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": true,
  "eventsEnabled": true,
  "eventsExpiration": 86400,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [],
  "adminEventsEnabled": false,
  "attributes": {
    "native-auth.flow-alias": "native",
    "native-auth.code-redirect-uri-mode": "none"
  },
  "clients": [
    {
      "clientId": "demo-ios",
      "name": "Demo iOS App",
      "description": "Public native client using the native authentication profile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "demoapp://auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "native-auth.enabled": "true",
        "oauth2.device.authorization.grant.enabled": "false",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "demo-ios-alt",
      "name": "Demo iOS App (alternatives flow)",
      "description": "Same as demo-ios but bound to the 'native-alternatives' flow (spec/08 Q2 prototype)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "demoapp://auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "native-auth.enabled": "true",
        "native-auth.flow-alias": "native-alternatives"
      }
    },
    {
      "clientId": "web-app",
      "name": "Web App (not native-enabled)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "Phone",
          "secretData": "{\"value\": \"alice-totp-secret-20261014\"}",
          "credentialData": "{\"subType\": \"totp\", \"digits\": 6, \"counter\": 0, \"period\": 30, \"algorithm\": \"HmacSHA1\"}"
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Passwordonly",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "bob-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Mustupdate",
      "requiredActions": [
        "UPDATE_PASSWORD"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "carol-password",
          "temporary": false
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "native",
      "description": "Native (browserless) authentication: username -> primary factor -> conditional second factor (spec/04 \u00a77)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "native-username"
        },
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "native - primary factor"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "flowAlias": "native - second factor"
        }
      ]
    },
    {
      "alias": "native - primary factor",
      "description": "ALTERNATIVE primary factors; native-passkey joins here in Phase 1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "native-password"
        }
      ]
    },
    {
      "alias": "native - second factor",
      "description": "Runs only when the user has a second-factor credential configured",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "native-totp"
        }
      ]
    },
    {
      "alias": "native-alternatives",
      "description": "spec/08 Q2 prototype: password and TOTP as ALTERNATIVE siblings in one subflow",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "native-username"
        },
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "native-alternatives - factor"
        }
      ]
    },
    {
      "alias": "native-alternatives - factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "native-password"
        },
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "native-totp"
        }
      ]
    }
  ]
}
