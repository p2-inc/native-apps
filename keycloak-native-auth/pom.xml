<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.phasetwo.keycloak</groupId>
  <artifactId>keycloak-native-auth-parent</artifactId>
  <version>0.4.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Keycloak Native Auth (parent)</name>
  <description>Browserless native authentication for Keycloak: FiPA-style authorization challenge endpoint plus native-aware authenticators.</description>

  <licenses>
    <license>
      <name>Elastic License v2</name>
      <url>https://www.elastic.co/licensing/elastic-license</url>
    </license>
  </licenses>

  <modules>
    <module>native-auth-core</module>
    <module>native-auth-authenticators</module>
    <module>native-auth-otp-sender</module>
    <module>native-auth-required-actions</module>
    <module>native-auth-endpoint</module>
    <module>push-mfa-extension-java21</module>
    <module>native-auth-push</module>
    <module>native-auth-push-apns</module>
    <module>native-auth-pin</module>
    <module>demo</module>
    <!-- Later: native-auth-events, conformance (see spec/04 §1). -->
  </modules>

  <properties>
    <!-- Q4 (spec/08): floor is 26.8.x. 26.8.1 is the latest 26.8 patch at the time of the Phase 0 spike
         (October 2026); see spec/09-phase0-decisions.md for the rationale. The same value must be used for
         the container image in demo/docker-compose.yml and the integration tests (keycloak.image.version). -->
    <keycloak.version>26.8.1</keycloak.version>
    <!-- ba-itsys push MFA (spec/01 §3, spec/14 D9): the dependency behind native-auth-push and the APNs sender. -->
    <push-mfa.version>2.3.7</push-mfa.version>
    <!-- Phase Two's PIN extension (spec/20 D1): the dependency behind native-auth-pin, shipped in the providers
         zip. One property, so moving to a released version is a one-line change. -->
    <keycloak-pin.version>0.1.0-SNAPSHOT</keycloak-pin.version>
    <keycloak.image>quay.io/keycloak/keycloak:${keycloak.version}</keycloak.image>

    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Keycloak 26.8 runs on Quarkus 3.40 (RESTEasy Reactive); the Jakarta REST API level is 3.1. -->
    <jakarta.ws.rs-api.version>3.1.0</jakarta.ws.rs-api.version>
    <jboss-logging.version>3.6.3.Final</jboss-logging.version>
    <junit.version>6.1.3</junit.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <rest-assured.version>6.1.0</rest-assured.version>

    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-core</artifactId>
        <version>${keycloak.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-server-spi</artifactId>
        <version>${keycloak.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-server-spi-private</artifactId>
        <version>${keycloak.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-services</artifactId>
        <version>${keycloak.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>jakarta.ws.rs</groupId>
        <artifactId>jakarta.ws.rs-api</artifactId>
        <version>${jakarta.ws.rs-api.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.jboss.logging</groupId>
        <artifactId>jboss-logging</artifactId>
        <version>${jboss-logging.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-crypto-default</artifactId>
        <version>${keycloak.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-endpoint</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-authenticators</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-required-actions</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-otp-sender</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-push</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-push-apns</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>native-auth-pin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- keycloak-pin is compiled against (provided); the demo module copies it into the providers zip. -->
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>keycloak-pin</artifactId>
        <version>${keycloak-pin.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- ba-itsys push MFA: our modules compile against the Java 21 rebuild (push-mfa-extension-java21). -->
      <dependency>
        <groupId>io.phasetwo.keycloak</groupId>
        <artifactId>keycloak-push-mfa-extension-java21</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured</artifactId>
        <version>${rest-assured.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
