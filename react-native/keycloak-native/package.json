{
  "name": "@phasetwo/react-native-keycloak-native",
  "version": "0.3.0-dev",
  "description": "React Native module for native authentication with Keycloak (wraps the iOS and Android SDKs)",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "phasetwo-react-native-keycloak-native-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "plugin",
    "app.plugin.js",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @phasetwo/react-native-keycloak-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\" \"example/src/**/*.{js,ts,tsx}\" \"plugin/**/*.js\" app.plugin.js",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "keycloak",
    "authentication",
    "passkeys",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2-inc/native-apps.git",
    "directory": "react-native/keycloak-native"
  },
  "author": "Phase Two, Inc. <support@phasetwo.io> (https://phasetwo.io)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/p2-inc/native-apps/issues"
  },
  "homepage": "https://github.com/p2-inc/native-apps/tree/main/react-native/keycloak-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "58.0.10",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "react-test-renderer": "19.3.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=54.0.0",
    "react": ">=19.2.0",
    "react-native": ">=0.88.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "KeycloakNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.phasetwo.keycloak.nativeauth.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "KeycloakNative": "KeycloakNativeModule"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.64.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "keycloakNativeSdkVersion": "0.3.0",
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  }
}
